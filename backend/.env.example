# --- Storage & locale ---
DATABASE_URL=sqlite:///./pillpulse.db
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=*

# --- Push notifications (FCM HTTP v1): service-account JSON or a path to it ---
